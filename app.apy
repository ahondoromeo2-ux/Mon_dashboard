from flask import Flask, render_template
from modules import meteo  # Import du module météo

app = Flask(__name__)

@app.route("/")
def home():
    return render_template("home.html")

@app.route("/meteo")
def meteo_page():
    infos = meteo.get_meteo()
    return render_template("meteo.html", meteo=infos)

if __name__ == "__main__":
    app.run(debug=True)
