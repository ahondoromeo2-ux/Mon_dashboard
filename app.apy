from flask import Flask, jsonify
import modules.meteo as meteo
import modules.horoscope as horoscope
import modules.laboratoire as laboratoire
import modules.new as new

app = Flask(__name__)

# --- ROUTES API ---

# Météo
@app.route("/api/meteo")
def api_meteo():
    try:
        result = meteo.get_weather()  # fonction à définir dans meteo.py
        return jsonify({"status": "success", "result": result})
    except Exception as e:
        return jsonify({"status": "error", "message": str(e)})

# Horoscope
@app.route("/api/horoscope")
def api_horoscope():
    try:
        result = horoscope.get_horoscope()  # fonction à définir dans horoscope.py
        return jsonify({"status": "success", "result": result})
    except Exception as e:
        return jsonify({"status": "error", "message": str(e)})

# Laboratoire
@app.route("/api/laboratoire")
def api_laboratoire():
    try:
        result = laboratoire.run_experiment()  # fonction à définir dans laboratoire.py
        return jsonify({"status": "success", "result": result})
    except Exception as e:
        return jsonify({"status": "error", "message": str(e)})

# Module de test
@app.route("/api/new")
def api_new():
    try:
        result = new.test_module()  # fonction à définir dans new.py
        return jsonify({"status": "success", "result": result})
    except Exception as e:
        return jsonify({"status": "error", "message": str(e)})

# --- MAIN ---
if __name__ == "__main__":
    app.run(debug=True, host="0.0.0.0", port=5000)
