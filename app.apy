import openai
from flask import Flask, render_template, request, jsonify
import config  # ta clé API est stockée ici

openai.api_key = config.OPENAI_API_KEY

app = Flask(__name__)

@app.route("/")
def home():
    return render_template("index.html")

@app.route("/assistant", methods=["POST"])
def assistant():
    user_input = request.json.get("message")

    # On demande à l’IA de répondre en JSON avec une intention
    system_prompt = """
    Tu es un assistant pour un dashboard. 
    Analyse la commande de l’utilisateur et renvoie uniquement un JSON avec une clé "action".
    Exemple: {"action":"mode sombre"} ou {"action":"agrandir sidebar"}.
    Si plusieurs actions sont demandées, renvoie une liste: {"actions":["mode sombre","agrandir sidebar"]}.
    Ne renvoie rien d’autre que du JSON.
    """

    response = openai.ChatCompletion.create(
        model="gpt-3.5-turbo",
        messages=[
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_input}
        ],
        max_tokens=100
    )

    ai_reply = response["choices"][0]["message"]["content"]
    return jsonify({"reply": ai_reply})

if __name__ == "__main__":
    app.run(debug=True)
